# Локальный запуск: cp .env.example .env. В docker-compose те же переменные приходят из корневого .env.
APP_ENV=development
LISTEN_ADDR=127.0.0.1:5199
DATABASE_URL=postgres://music:dev@127.0.0.1:55433/music
JWT_SIGNING_KEY=
STORAGE_ROOT=../storage
OWNER_USERNAME=admin
OWNER_PASSWORD=
RUST_LOG=info,sqlx=warn
# Внешние сервисы — по умолчанию настоящие адреса:
# LRCLIB_BASE_URL=https://lrclib.net
# DEEZER_BASE_URL=https://api.deezer.com
# YANDEX_MUSIC_BASE_URL=https://api.music.yandex.net
