

IMAGE_PREFIX=ghcr.io/bulatruslanovich/music-streaming
IMAGE_TAG=latest

POSTGRES_USER=music
POSTGRES_DB=music
POSTGRES_PASSWORD=

JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=10
JWT_REFRESH_TOKEN_DAYS=30

OWNER_USERNAME=admin
OWNER_DISPLAY_NAME=
OWNER_PASSWORD=
OWNER_RESET_PASSWORD=false

MUSIC_STORAGE_PATH=./storage

PUID=1000
PGID=1000

MAX_UPLOAD_BYTES=209715200
MAX_UPLOAD_BODY_BYTES=268435456

TRANSCODE_ENABLED=true
HLS_SEGMENT_SECONDS=4

# Сколько рендишенов готовится одновременно. Один воркер всегда закреплён за треком, который
# слушают прямо сейчас, остальные греют библиотеку. 0 — половина ядер машины.
TRANSCODE_WORKERS=0

TRANSCODE_BACKFILL_ENABLED=true
TRANSCODE_BACKFILL_BATCH=8
TRANSCODE_BACKFILL_PAUSE_SECONDS=5

LASTFM_API_KEY=
LASTFM_API_SECRET=

LIBRARY_ENRICHMENT_ENABLED=true

AUDIODB_API_KEY=2
AUDIODB_REQUEST_DELAY_MS=1000

LRCLIB_REQUEST_DELAY_MS=500

PUBLIC_DOMAIN=music.example.com
HTTP_PORT=80
HTTPS_PORT=443

RECOMMENDATIONS_ENABLED=true

# Всё остальное в рекомендациях — веса ранжирования, и настраиваются они не здесь: их
# подбирает make eval и держит код. Эмбеддинги звучания тоже: настоящей модели в сборке
# ещё нет, а заглушка ничего не спрашивает.

# Эмбеддинги звучания (CLAP через ONNX Runtime) — «звуковая» половина рекомендаций.
# Модель весит ~280 МБ и в git не входит: положите audio.onnx и банк mel-фильтров в
# <storage>/models/clap, выгрузив их скриптом backend/scripts/export_clap_audio_onnx.py.
# Без них IsAvailable=false, и рекомендации работают на метаданных и коллаборативных сигналах.
# ModelSha256 необязателен, но заполненный означает отказ грузить подменённый граф.
# ВНИМАНИЕ: смена модели или стратегии нарезки переэмбеддит всю библиотеку — часы или сутки CPU.
AUDIO_EMBEDDING_ENABLED=true
# clap — настоящая модель; deterministic — дубль для локальной разработки без неё.
AUDIO_EMBEDDING_PROVIDER=clap
AUDIO_EMBEDDING_MODEL_PATH=models/clap/audio.onnx
AUDIO_EMBEDDING_MEL_FILTERS_PATH=models/clap/mel_filters_64x513.f32
AUDIO_EMBEDDING_MODEL_SHA256=
AUDIO_EMBEDDING_INTRA_OP_THREADS=0

BACKEND_PORT=8080

# Потолки памяти контейнеров. Без них при нехватке памяти ядро выбирает жертву само, и ей
# вполне может оказаться postgres. Значения по умолчанию рассчитаны примерно на 6 ГБ machine;
# на 4 ГБ имеет смысл опустить BACKEND_MEMORY_LIMIT до 1500m, на 8+ — можно поднять.
POSTGRES_MEMORY_LIMIT=1g
BACKEND_MEMORY_LIMIT=2g
FRONTEND_MEMORY_LIMIT=512m

# Настройки postgres. Главная здесь — work_mem: пересборка похожести сортирует и агрегирует
# временные таблицы на миллионы строк, и на дефолтных 4 МБ каждый такой шаг уходит на диск.
# temp_file_limit ограничивает запрос, раздувшийся на кривых данных, ошибкой прохода, а не
# заполненным томом.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_TEMP_FILE_LIMIT=4GB
POSTGRES_MAX_WAL_SIZE=2GB
# Потолок пула Npgsql. Держите его ниже max_connections самого postgres.
POSTGRES_MAX_POOL_SIZE=40
