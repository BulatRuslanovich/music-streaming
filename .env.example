

IMAGE_PREFIX=ghcr.io/bulatruslanovich/music-streaming
IMAGE_TAG=latest

POSTGRES_USER=music
POSTGRES_DB=music
POSTGRES_PASSWORD=

JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=10
JWT_REFRESH_TOKEN_DAYS=30

OWNER_USERNAME=admin
OWNER_DISPLAY_NAME=
OWNER_PASSWORD=
OWNER_RESET_PASSWORD=false

MUSIC_STORAGE_PATH=./storage

PUID=1000
PGID=1000

MAX_UPLOAD_BYTES=209715200
MAX_UPLOAD_BODY_BYTES=268435456

HISTORY_THRESHOLD_SECONDS=30

TRANSCODE_ENABLED=true
TRANSCODE_LOW_KBPS=64
TRANSCODE_NORMAL_KBPS=128
TRANSCODE_HIGH_KBPS=192
HLS_SEGMENT_SECONDS=4

TRANSCODE_BACKFILL_ENABLED=true
TRANSCODE_BACKFILL_BATCH=8
TRANSCODE_BACKFILL_PAUSE_SECONDS=5

LIBRARY_IMPORT_ENABLED=true
LIBRARY_IMPORT_DIR=import
LIBRARY_IMPORT_SCAN_INTERVAL_SECONDS=300
LIBRARY_IMPORT_BATCH=50
LIBRARY_IMPORT_MIN_AGE_SECONDS=15 
LIBRARY_IMPORT_AFTER=delete

LOGIN_ATTEMPTS_PER_MINUTE=10
UPLOADS_PER_MINUTE=60
SEARCHES_PER_MINUTE=120
EVENTS_PER_MINUTE=120
ACCOUNT_LOCKOUT_ATTEMPTS=10
ACCOUNT_LOCKOUT_MINUTES=15

LASTFM_API_KEY=
LASTFM_API_SECRET=

LIBRARY_ENRICHMENT_ENABLED=true

AUDIODB_API_KEY=2
AUDIODB_REQUEST_DELAY_MS=1000

LRCLIB_REQUEST_DELAY_MS=500

PUBLIC_DOMAIN=music.example.com
HTTP_PORT=80
HTTPS_PORT=443

RECOMMENDATIONS_ENABLED=true
RECOMMENDATIONS_SHELF_SIZE=12
RECOMMENDATIONS_EXPLORATION_RATIO=0.25
RECOMMENDATIONS_EVENT_RETENTION_DAYS=180


BACKEND_PORT=8080
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=720h
