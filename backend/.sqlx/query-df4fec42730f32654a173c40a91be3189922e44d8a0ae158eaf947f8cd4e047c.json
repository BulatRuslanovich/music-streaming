  "query": "SELECT p.id, p.name, p.description, p.is_public, p.user_id, u.username, p.cover_path, p.created_at, p.updated_at\n           FROM playlists p JOIN users u ON u.id = p.user_id\n           WHERE p.id = $1 AND (p.user_id = $2 OR p.is_public)",
