  "query": "SELECT t.id, t.title, ar.name AS artist, t.album_id, al.cover_path IS NOT NULL AS \"has_cover!\", g.name AS \"genre?\"\n               FROM tracks t JOIN artists ar ON ar.id = t.artist_id\n               LEFT JOIN albums al ON al.id = t.album_id LEFT JOIN genres g ON g.id = t.genre_id",
