# ==============================================================================================
# Copy to .env and fill in before the first `docker compose up`.
#
#   cp .env.example .env
#
# .env is git-ignored. Generate the two secrets below with:
#   openssl rand -base64 48
# ==============================================================================================

POSTGRES_USER=music
POSTGRES_DB=music
POSTGRES_PASSWORD=music

JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30

OWNER_USERNAME=admin
OWNER_DISPLAY_NAME=Bulat
OWNER_PASSWORD=12345678
OWNER_RESET_PASSWORD=false

MUSIC_STORAGE_PATH=./storage

PUID=1000
PGID=1000

MAX_UPLOAD_BYTES=209715200

HISTORY_THRESHOLD_SECONDS=30

# Audio quality ladder. Low/Normal/High are Opus renditions cached on first request; Original is
# the untouched upload and always plays, even where Opus does not.
TRANSCODE_ENABLED=true
TRANSCODE_LOW_KBPS=64
TRANSCODE_NORMAL_KBPS=128
TRANSCODE_HIGH_KBPS=192

# Last.fm scrobbling. Optional: leave empty and the integration is not offered at all.
# Create an application at https://www.last.fm/api/account/create to get the pair.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Фотографии исполнителей с TheAudioDB — только для разовой догрузки:
#   docker compose --profile tools run --rm --build artist-images --limit 50
# По умолчанию берётся общий тестовый ключ "2": он работает, но жёстко ограничен по частоте, и на
# большой фонотеке часть исполнителей вернётся как «errored». Свой ключ снимает этот потолок.
AUDIODB_API_KEY=2
AUDIODB_REQUEST_DELAY_MS=1000

PUBLIC_DOMAIN=music.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Recommendations. Everything else is tuned in appsettings.json; these are the knobs worth
# reaching for from here. Turning the engine off stops the background workers — the API keeps
# answering, and falls back to popularity and new arrivals.
RECOMMENDATIONS_ENABLED=true
RECOMMENDATIONS_SHELF_SIZE=12
RECOMMENDATIONS_EXPLORATION_RATIO=0.25
RECOMMENDATIONS_EVENT_RETENTION_DAYS=180

# Metrics and logs. Grafana binds to loopback only — reach it over an SSH tunnel:
#   ssh -L 3001:127.0.0.1:3001 your-host
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=720h
