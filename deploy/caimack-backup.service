# Ночной снапшот базы и storage.
# Установка (подставьте своего пользователя и путь к проекту):
#   sudo cp deploy/caimack-backup.{service,timer} /etc/systemd/system/
#   sudoedit /etc/systemd/system/caimack-backup.service   # User= и WorkingDirectory=
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now caimack-backup.timer
#   systemctl list-timers caimack-backup.timer
#   journalctl -u caimack-backup.service -n 50

[Unit]
Description=Caimack backup (postgres + storage)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=caimack
WorkingDirectory=/srv/music-streaming
ExecStart=/srv/music-streaming/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
