{
  "Jwt": {
    "Issuer": "music-streaming",
    "Audience": "music-streaming",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "Storage": {
    "RootPath": "/storage",
    "MaxUploadBytes": 31457280,
    "MaxImageUploadBytes": 8388608
  },
  "Playback": {
    "HistoryThresholdSeconds": 30,
    "HistoryRetentionEntries": 1000
  },
  "Owner": {
    "Username": "admin",
    "DisplayName": "",
    "Password": "",
    "ResetPasswordOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
