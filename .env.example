# ==============================================================================================
# Копировать .env перед `docker compose up`.
#
#   cp .env.example .env

#   openssl rand -base64 48
# ==============================================================================================

IMAGE_PREFIX=ghcr.io/bulatruslanovich/music-streaming
IMAGE_TAG=latest

POSTGRES_USER=music
POSTGRES_DB=music
POSTGRES_PASSWORD=

JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=10
JWT_REFRESH_TOKEN_DAYS=30

OWNER_USERNAME=admin
OWNER_DISPLAY_NAME=
OWNER_PASSWORD=
OWNER_RESET_PASSWORD=false

MUSIC_STORAGE_PATH=./storage

PUID=1000
PGID=1000

# Потолок одного аудиофайла. Второе число — граница тела запроса на обратном прокси; держите
# его выше первого, иначе файл разрешённого размера не пройдёт из-за служебных байт multipart.
MAX_UPLOAD_BYTES=209715200
MAX_UPLOAD_BODY_BYTES=268435456

HISTORY_THRESHOLD_SECONDS=30

TRANSCODE_ENABLED=true
TRANSCODE_LOW_KBPS=64
TRANSCODE_NORMAL_KBPS=128
TRANSCODE_HIGH_KBPS=192

LASTFM_API_KEY=
LASTFM_API_SECRET=

LIBRARY_ENRICHMENT_ENABLED=true # фоновые фото новых артистов и тексты новых треков

AUDIODB_API_KEY=2
AUDIODB_REQUEST_DELAY_MS=1000

#  LRCLIB бесплатен и ключа не просит, так что настраивать тут нечего, кроме паузы между запросами
LRCLIB_REQUEST_DELAY_MS=500

PUBLIC_DOMAIN=music.example.com
HTTP_PORT=80
HTTPS_PORT=443

RECOMMENDATIONS_ENABLED=true
RECOMMENDATIONS_SHELF_SIZE=12
RECOMMENDATIONS_EXPLORATION_RATIO=0.25
RECOMMENDATIONS_EVENT_RETENTION_DAYS=180


# Оба порта слушают только петлю на сервере, снаружи их нет. Ходить туннелем:
#
#   ssh -L 3001:127.0.0.1:3001 music.caimack   → http://localhost:3001       (Grafana)
#   ssh -L 8080:127.0.0.1:8080 music.caimack   → http://localhost:8080/docs  (схема API)
BACKEND_PORT=8080
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=720h
