# ==============================================================================================
# Copy to .env and fill in before the first `docker compose up`.
#
#   cp .env.example .env
#
# .env is git-ignored. Generate the two secrets below with:
#   openssl rand -base64 48
# ==============================================================================================

# --- database ---------------------------------------------------------------------------------
POSTGRES_USER=music
POSTGRES_DB=music
# REQUIRED. Any long random string; only the API ever connects to this database.
POSTGRES_PASSWORD=

# --- authentication ---------------------------------------------------------------------------
# REQUIRED. HMAC key used to sign JWTs; must be at least 32 bytes. Changing it signs everyone out.
JWT_SIGNING_KEY=

# How long an access token lasts. The frontend refreshes silently, so a short life costs nothing.
JWT_ACCESS_TOKEN_MINUTES=30
# How long a session survives without use before requiring a fresh sign-in.
JWT_REFRESH_TOKEN_DAYS=30

# --- your account -----------------------------------------------------------------------------
# Created on first start. Afterwards these are ignored unless OWNER_RESET_PASSWORD=true.
OWNER_USERNAME=admin
OWNER_DISPLAY_NAME=
# REQUIRED on first start. At least 8 characters.
OWNER_PASSWORD=

# Set to true for one start to change the password, then set it back to false.
OWNER_RESET_PASSWORD=false

# --- storage ----------------------------------------------------------------------------------
# Host directory holding the MP3s and cover art. Point this at wherever you keep your library —
# an external disk works fine.
MUSIC_STORAGE_PATH=./storage

# The API container runs as this user so it can write to the directory above. Set these to the
# output of `id -u` and `id -g` if your user is not the usual 1000:1000.
PUID=1000
PGID=1000

# Per-file upload limit in bytes. Default: 100 MB.
MAX_UPLOAD_BYTES=104857600

# --- playback ---------------------------------------------------------------------------------
# Seconds of listening before a track is recorded in the history.
HISTORY_THRESHOLD_SECONDS=30

# --- local access -----------------------------------------------------------------------------
# Port on the host. Reach the app at http://localhost:8080 or http://<home-ip>:8080 on your LAN.
LOCAL_HTTP_PORT=8080
# Use 127.0.0.1 to make the service reachable only through the Cloudflare tunnel.
LOCAL_BIND_ADDRESS=0.0.0.0

# --- remote access (Cloudflare Tunnel) --------------------------------------------------------
# Token from a Cloudflare Zero Trust tunnel. See README section "Remote access".
# Leave empty to run LAN-only; the cloudflared service is behind the `tunnel` profile, so it only
# starts with:  docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
