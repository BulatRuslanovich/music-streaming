<!-- Превью виджета в каталоге лаунчера: та же раскладка в цветах палитры «Кофе». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:backgroundTint="#2A221D"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="150dp"
        android:layout_height="116dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview_art" />

    <LinearLayout
        android:id="@+id/widget_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="@string/widget_daily_mix"
            android:textColor="#EFE4D2"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#B3A595"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_primary"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_button"
                android:backgroundTint="#EFE4D2"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_play"
                android:tint="#1C1714" />

            <ImageButton
                android:id="@+id/widget_secondary"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_button"
                android:backgroundTint="#3A2F28"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_next"
                android:tint="#EFE4D2" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
