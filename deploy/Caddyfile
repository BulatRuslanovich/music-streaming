{
	admin off

	log {
		format console
		level INFO
	}
}

(app) {
	handle /api/* {
		reverse_proxy backend:8080 {
			flush_interval -1

			header_up X-Real-IP {remote_host}
		}
	}

	handle /health {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}

	# Внешняя граница тела запроса. Настоящий лимит на файл живёт в приложении
	# (Storage:MaxUploadBytes), а здесь стоит потолок с запасом на служебные байты multipart:
	# отсечь переросшее до бэкенда дешевле, чем принимать его и отвергать там.
	#
	# Держать это число выше MAX_UPLOAD_BYTES обязательно — иначе файл ровно в разрешённый
	# размер не пройдёт прокси и человек увидит ошибку Caddy вместо понятного ответа API.
	request_body {
		max_size {$MAX_UPLOAD_BODY_BYTES:268435456}
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# 'unsafe-inline' у скриптов остаётся: Next.js поднимает приложение встроенным блоком, и
		# без nonce на каждый ответ его не убрать. А вот 'unsafe-eval' нужен только режиму
		# разработки — в собранном приложении eval не зовёт никто, и держать его открытым значит
		# заранее снимать главный барьер на случай, если XSS всё-таки появится.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		-Server
	}

	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}
}

{$PUBLIC_DOMAIN:localhost} {
	import app
}

http://:8081 {
	handle /health {
		reverse_proxy backend:8080
	}

	respond 404
}
